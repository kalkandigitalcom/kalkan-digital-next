# ---------------------------------------------------------------------------
# Kalkan Digital – environment variables
# Copy to .env.local for development. In Coolify, add these as environment
# variables (mark secrets as "secret"). NEVER commit real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection (your own server; Supabase not required)
DATABASE_URL=postgres://kalkan:CHANGE_ME@postgres:5432/kalkan_digital
DATABASE_POOL_MAX=10

# Secret used to HMAC rate-limit keys. Generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_AT_LEAST_32_CHARS
# Admin session lifetime in hours (absolute expiry)
SESSION_TTL_HOURS=12

# Optional one-time setup page (/admin/setup) to create the FIRST admin.
# Works only while no admin exists. Remove the value after setup.
# Generate with: openssl rand -hex 24
ADMIN_SETUP_TOKEN=

# "auto" = Secure cookie in production. Set to "false" only for plain-http local testing.
COOKIE_SECURE=auto
# Trust X-Forwarded-For from the reverse proxy (Coolify/Traefik). Keep "true" behind a proxy.
TRUST_PROXY=true
# Number of reverse proxies in front of the app (Coolify/Traefik = 1; add 1 if behind Cloudflare too)
TRUSTED_PROXY_HOPS=1

# Uploaded portfolio images (mount a persistent volume here in Docker)
UPLOAD_DIR=./uploads

# Run DB migrations automatically on container start (forward-only, non-destructive)
RUN_MIGRATIONS=true

# Public values (safe for the browser, baked in at build time)
NEXT_PUBLIC_SITE_URL=https://kalkandigital.com
# Fallbacks; the values in Admin > Ayarlar take precedence on the website
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Tests only – a LOCAL (localhost / 127.0.0.1), disposable database whose name ends with "_test".
# Tests truncate every table; any other URL is rejected before tests start (tests/test-db-guard.ts).
# TEST_DATABASE_URL=postgres://kalkan:CHANGE_ME@localhost:5432/kalkan_digital_test
